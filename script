-- ─────────────────────────────────────────────────────
-- ANIMATION KILLER
-- Stops every playing AnimationTrack on the Animator.
-- Called before instant-catch remote fire so the
-- instrument swing anim never plays.
-- ─────────────────────────────────────────────────────
local function KillAnimations()
    if not Animator then return end
    for _, track in ipairs(Animator:GetPlayingAnimationTracks()) do
        track:Stop(0) -- 0 = instant, no fade
    end
end

-- Patch: prevent new animation tracks from playing while InstantCatch is on
local AnimGuard
local function EnableAnimGuard()
    if AnimGuard then return end
    AnimGuard = Animator.AnimationPlayed:Connect(function(track)
        if State.InstantCatch then
            task.defer(function() track:Stop(0) end)
        end
    end)
end

local function DisableAnimGuard()
    if AnimGuard then
        AnimGuard:Disconnect()
        AnimGuard = nil
    end
end

-- ─────────────────────────────────────────────────────
-- REMOTE CACHE
-- Scan for all catch/note/frequency remotes once, cache.
-- ─────────────────────────────────────────────────────
local function CacheCatchRemotes()
    State.CatchRemotes = {}
    local patterns = {"catch", "note", "frequency", "tame", "play", "instrument", "minigame", "scroom"}
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local n = obj.Name:lower()
            for _, p in ipairs(patterns) do
                if n:find(p) then
                    table.insert(State.CatchRemotes, obj)
                    break
                end
            end
        end
    end
end

-- ─────────────────────────────────────────────────────
-- INSTANT CATCH HOOK
-- On minigame GUI appear → kill anim → fire remotes → done.
-- No wait, no animation tick, straight to caught.
-- ─────────────────────────────────────────────────────
local InstantCatchConn
local function EnableInstantCatch()
    if InstantCatchConn then return end
    CacheCatchRemotes()
    EnableAnimGuard()

    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return end

    local function HandleMinigameGui(sg)
        if not State.InstantCatch then return end
        -- Kill instrument animation immediately
        KillAnimations()

        -- Fire every known catch remote with common success payloads
        for _, remote in ipairs(State.CatchRemotes) do
            pcall(function()
                if remote:IsA("RemoteEvent") then
                    -- Try common payload shapes Scrooms-style games use
                    remote:FireServer(true)          -- success bool
                    remote:FireServer("catch", true) -- action + bool
                    remote:FireServer(1)             -- note index 1
                end
            end)
        end

        -- Also auto-click any confirm/catch buttons that appear
        task.spawn(function()
            task.wait(0.05)
            for _, btn in ipairs(sg:GetDescendants()) do
                if (btn:IsA("TextButton") or btn:IsA("ImageButton")) then
                    local n = btn.Name:lower()
                    if n:find("confirm") or n:find("catch") or n:find("note")
                    or n:find("play") or n:find("yes") or n:find("ok") then
                        KillAnimations()
                        pcall(function() btn:FireMouseButton1Click() end)
                        task.wait(0.02)
                        -- keep killing anim in case re-trigger
                        KillAnimations()
                    end
                end
            end
        end)

        -- Watch for frames dynamically added to the minigame
        sg.DescendantAdded:Connect(function(desc)
            if not State.InstantCatch then return end
            if desc:IsA("TextButton") or desc:IsA("ImageButton") then
                local n = desc.Name:lower()
                if n:find("note") or n:find("confirm") or n:find("play") then
                    KillAnimations()
                    task.wait(0.02)
                    pcall(function() desc:FireMouseButton1Click() end)
                    KillAnimations()
                end
            end
        end)
    end

    InstantCatchConn = gui.ChildAdded:Connect(function(child)
        if State.InstantCatch and child:IsA("ScreenGui") then
            HandleInstantCatch = true
            task.spawn(function()
                task.wait(0.05)
                HandleMinigameGui(child)
            end)
        end
    end)
end

local function DisableInstantCatch()
    DisableAnimGuard()
    if InstantCatchConn then
        InstantCatchConn:Disconnect()
        InstantCatchConn = nil
    end
end

-- ─────────────────────────────────────────────────────
-- QUEST READER
-- ─────────────────────────────────────────────────────
local function ReadQuestInfo(): string
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return "No PlayerGui found." end

    local questGui = gui:FindFirstChild("QuestLog")
                  or gui:FindFirstChild("QuestUI")
                  or gui:FindFirstChild("QuestScreen")
    if questGui then
        local lines = {}
        for _, label in ipairs(questGui:GetDescendants()) do
            if label:IsA("TextLabel") or label:IsA("TextBox") then
                local txt = label.Text:match("^%s*(.-)%s*$")
                if #txt > 2 then table.insert(lines, txt) end
            end
        end
        if #lines > 0 then return table.concat(lines, "\n") end
    end

    local collected = {}
    local kw = {"quest","objective","reward","collect","catch","bring","find","give","chime","scroom"}
    for _, sg in ipairs(gui:GetChildren()) do
        if sg:IsA("ScreenGui") then
            for _, label in ipairs(sg:GetDescendants()) do
                if label:IsA("TextLabel") then
                    local t = label.Text:lower()
                    for _, k in ipairs(kw) do
                        if t:find(k) and #label.Text > 5 then
                            table.insert(collected, label.Text)
                            break
                        end
                    end
                end
            end
        end
    end

    if #collected > 0 then
        local seen, unique = {}, {}
        for _, v in ipairs(collected) do
            if not seen[v] then seen[v]=true; table.insert(unique, v) end
        end
        return table.concat(unique, "\n")
    end
    return "Quest log not visible — open hotbar slot 4 first."
end

