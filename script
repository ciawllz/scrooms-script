-- TELEPORT
-- ─────────────────────────────────────────────────────
local function TeleportTo(target)
    local cf = typeof(target) == "Vector3"
        and CFrame.new(target + Vector3.new(0, 4, 0))
        or  target
    if RootPart then RootPart.CFrame = cf end
end

-- ─────────────────────────────────────────────────────
-- LIVE NPC SCANNER
-- Walks all workspace descendants, collects every Model
-- that has a Humanoid (NPC), returns sorted list of
-- {name, model, cframe}. Runs on demand, no cached state.
-- ─────────────────────────────────────────────────────
local function ScanNPCs()
    local found = {}
    local seen  = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and not seen[obj] then
            local hum  = obj:FindFirstChildOfClass("Humanoid")
            local root = obj:FindFirstChild("HumanoidRootPart")
                      or obj.PrimaryPart
                      or obj:FindFirstChildWhichIsA("BasePart")
            -- exclude the local character
            if hum and root and obj ~= Character then
                seen[obj] = true
                table.insert(found, {
                    name   = obj.Name,
                    model  = obj,
                    cframe = root.CFrame * CFrame.new(0, 0, 4),
                })
            end
        end
    end
    table.sort(found, function(a, b) return a.name < b.name end)
    return found
end

